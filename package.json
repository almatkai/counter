{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "id": "com.tezbar.counter",
  "name": "counter",
  "title": "Counter",
  "description": "A simple counter, in the comfort of Raycast root!",
  "icon": "command-icon.png",
  "author": "almatkai",
  "contributors": ["EvanZhouDev", "pernielsentikaer"],
  "categories": ["Productivity", "Fun"],
  "license": "MIT",
  "platforms": ["macOS", "Windows"],
  "commands": [
    {
      "name": "increment-counter",
      "title": "Increment Counter",
      "description": "Increments the count of the counter.",
      "mode": "no-view",
      "subtitle": "Value: 0",
      "platforms": ["macOS", "Windows"]
    },
    {
      "name": "decrement-counter",
      "title": "Decrement Counter",
      "description": "Decrements the count of the counter.",
      "mode": "no-view",
      "subtitle": "Value: 0",
      "platforms": ["macOS", "Windows"]
    },
    {
      "name": "reset-counter",
      "title": "Reset Counter",
      "description": "Resets the counter.",
      "mode": "no-view",
      "platforms": ["macOS", "Windows"]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": ["macos", "windows"],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/counter",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/counter",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
